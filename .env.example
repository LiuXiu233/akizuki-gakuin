# ============================================================
# 秋月学院 · 后端环境变量（复制为 .env 后修改；.env 已在 .gitignore 中）
# ============================================================

# ---------- 基础 ----------
# 可变数据目录（用户 / 存档 / 图片）。默认 ./data
AKIZUKI_DATA_DIR=

# 访问口令。留空 = 任何人都能访问（只建议在内网这么做）
AKIZUKI_ACCESS_PASSWORD=

# 允许的前端来源，逗号分隔。上线时改成你的 Vercel 域名
AKIZUKI_ALLOW_ORIGINS=*

# 同时驻留内存的世界数量上限
AKIZUKI_MAX_CACHED_SESSIONS=32
# 每个用户最多几个存档
AKIZUKI_MAX_WORLDS_PER_USER=20
# 服务器最多接纳多少个用户（0 = 不限）
AKIZUKI_MAX_USERS=0

# ---------- LLM（可留空：留空则玩家必须自带 key）----------
# openai | anthropic
AKIZUKI_LLM_PROVIDER=openai
# OpenAI 兼容端点写到 /v1 为止，例如 https://api.openai.com/v1
# Anthropic 写 https://api.anthropic.com
AKIZUKI_LLM_BASE_URL=
AKIZUKI_LLM_API_KEY=
AKIZUKI_LLM_MODEL=

# ---------- 文生图（可留空：留空则整个立绘系统自动关闭）----------
AKIZUKI_IMAGE_ENABLED=true
# openai | custom
AKIZUKI_IMAGE_PROVIDER=openai
AKIZUKI_IMAGE_BASE_URL=
AKIZUKI_IMAGE_API_KEY=
AKIZUKI_IMAGE_MODEL=
AKIZUKI_IMAGE_SIZE=1024x1024
# 强制 SFW 提示词约束（主流图像 API 会拒绝尺度内容，关掉会大量生成失败）
AKIZUKI_IMAGE_SFW=true
# 全局画风前缀，留空则用内置的日系动画风
AKIZUKI_IMAGE_STYLE=
# provider=custom 时：请求体 JSON 模板（{prompt} {model} {size} 会被替换）
AKIZUKI_IMAGE_REQUEST_TEMPLATE=
# provider=custom 时：从响应里取图的 JSON 路径，例如 data.0.b64_json 或 images.0
AKIZUKI_IMAGE_RESPONSE_PATH=

# ---------- 超时 ----------
AKIZUKI_REQUEST_TIMEOUT=180
AKIZUKI_TURN_TIMEOUT=300
